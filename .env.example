# ==============================================
# AI Product Curator - Environment Configuration
# ==============================================

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/ecommerce_ai
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_ai
DB_USER=username
DB_PASSWORD=password

# Database Pool Configuration
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# ==============================================
# LLM API Configuration (Choose one)
# ==============================================

# Groq API (Recommended - Fast & Free)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# HuggingFace API (Fallback)
# Get your API key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=microsoft/Phi-3-mini-4k-instruct

# ==============================================
# Authentication (JWT)
# ==============================================
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================
# Redis Configuration (Optional - for caching)
# ==============================================
REDIS_URL=redis://localhost:6379/0

# ==============================================
# API Configuration
# ==============================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS Origins (comma-separated)
# Add your frontend URLs here
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://curatly.onrender.com

# ==============================================
# Application Settings
# ==============================================
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO
DEBUG=true

# Scraper Settings
REQUEST_TIMEOUT=30
MAX_RETRIES=3
SCRAPING_DELAY=2
